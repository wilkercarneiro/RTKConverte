# Frontend (Vite) — configurar também no painel da Vercel
VITE_SUPABASE_URL=https://utxqkbgfgpbczqjtieyu.supabase.co
VITE_SUPABASE_ANON_KEY=<chave anon do projeto>
# Cadastro self-service ("Criar conta"). SÓ "true" depois da migração de
# escritórios (docs/multiescritorio/README.md); antes dela, conta nova vê tudo.
VITE_CADASTRO_ABERTO=false
# Canal de suporte mostrado em "Ajuda" (opcionais)
VITE_SUPORTE_EMAIL=
VITE_SUPORTE_WHATSAPP=
VITE_SUPORTE_PRAZO=

# Scripts de setup/E2E (Node)
SUPABASE_URL=https://utxqkbgfgpbczqjtieyu.supabase.co
SUPABASE_ANON_KEY=<chave anon do projeto>
SETUP_SECRET=<segredo da tabela config_setup>
E2E_EMAIL=<e-mail do usuário do sistema>
E2E_PASSWORD=<senha do usuário do sistema>
